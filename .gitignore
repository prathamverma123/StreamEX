# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-exe/
build/
out/
release/
*.tsbuildinfo
# Generated by apps/worker/scripts/package.mjs at installer-build time.
scripts/installer/version.iss

# Prisma
apps/api/prisma/*.db

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
out.log
err.log
w.txt
p.txt
full.txt
rl.txt

# Coverage
coverage/
.nyc_output/

# Media / storage artifacts (local storage backend, ffmpeg scratch, HLS output)
# NOTE: /storage is ROOT-ANCHORED so it does NOT exclude packages/storage/ —
# an unanchored "storage/" pattern would silently ignore the storage package.
/storage/
/uploads/
/media/
/work/
/tmp/
/test-artifacts/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
