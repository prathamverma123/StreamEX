# =============================================================================
# StreamEX — environment configuration
# Copy to `.env` and fill in real values. Every variable used by the API,
# worker, storage package, docker-compose and nginx is documented here.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=development                       # development | test | production
PORT=4000                                  # API HTTP port
WORKER_NAME=streamex-worker-1              # BullMQ worker identifier (must be unique per replica)
API_URL=http://localhost:4000              # Public base URL of the API (used in emails, swagger)
CDN_BASE_URL=http://localhost:8080         # Public base URL for HLS / media delivery (nginx or CDN)
FRONTEND_URL=http://localhost:5173         # CORS origin of the React frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000  # Comma separated allowed origins

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql://streamex:streamex@localhost:5432/streamex?schema=public
POSTGRES_USER=streamex
POSTGRES_PASSWORD=streamex
POSTGRES_DB=streamex

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- Authentication ----------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long!
# kid (key id) stamped into JWT headers. When rotating secrets, start a new
# generation: set JWT_ACCESS_SECRET_PREVIOUS / JWT_REFRESH_SECRET_PREVIOUS to
# the old secret and bump the kids. Tokens signed with the previous secret
# keep validating until they expire. See docs/RUNBOOK.md.
JWT_ACCESS_KID=streamex-access-2026a
JWT_REFRESH_KID=streamex-refresh-2026a
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=
JWT_PREVIOUS_KID=streamex-2025z
JWT_ACCESS_TTL=15m                          # Access token lifetime
JWT_REFRESH_TTL=30d                         # Refresh token / session lifetime
REFRESH_TOKEN_REUSED_TTL=5m                 # Grace window before a reused refresh token is reported
ADMIN_BOOTSTRAP_EMAIL=admin@streamex.dev    # Seeded admin account (see prisma/seed.ts)
ADMIN_BOOTSTRAP_PASSWORD=Admin123!          # Seeded admin password — change immediately

# --- HLS playback URL signing -------------------------------------------------
HLS_SIGNING_SECRET=change-me-hls-signing-secret-32-chars-min!!
HLS_TOKEN_TTL_SECONDS=3600                  # Signed manifest / segment URL lifetime
HLS_SEGMENT_PREFIX=hls                      # Path prefix under CDN_BASE_URL where nginx serves HLS

# --- Storage backend ----------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage                # Local filesystem root (relative to process cwd)
S3_ENDPOINT=                                # Optional: MinIO / DigitalOcean Spaces / R2 endpoint
S3_REGION=us-east-1
S3_BUCKET=streamex-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true                    # true for MinIO / local S3-compatible stores
S3_SIGNED_URL_TTL_SECONDS=3600              # Presigned GET URL lifetime for S3-backed playback
S3_USE_PRESIGNED_PLAYBACK=false             # true: playback URLs are presigned; false: nginx proxy

# --- Uploads ------------------------------------------------------------------
UPLOAD_MAX_BYTES=21474836480                # 20 GiB max source file size
UPLOAD_CHUNK_SIZE=8388608                   # 8 MiB chunk size for resumable uploads
UPLOAD_TTL_SECONDS=86400                    # Stale upload-session cleanup age

# --- Transcoding --------------------------------------------------------------
# Encoding ladder (see docs/ARCHITECTURE.md). Comma separated rungs
# height:bitrate_kbps:codec — override carefully, the worker aligns keyframes
# across every rung.
TRANSCODE_LADDER=240:400,480:1000,720:2500,1080:5000,2160:15000
TRANSCODE_VIDEO_CODEC=libx264              # libx264 or h264_nvenc / libsvtav1 etc.
TRANSCODE_AUDIO_BITRATE_KBPS=128
TRANSCODE_AUDIO_CODEC=aac
TRANSCODE_HLS_SECONDS=2                     # Segment duration
TRANSCODE_KEYFRAME_SECONDS=2               # GOP length — MUST equal TRANSCODE_HLS_SECONDS
TRANSCODE_X264_PRESET=medium                # speed/size tradeoff for libx264
TRANSCODE_CONCURRENCY=2                     # Parallel jobs per worker process
TRANSCODE_TMP_DIR=./work                    # Scratch dir for ffmpeg
TRANSCODE_MAX_ATTEMPTS=3                   # Attempts before dead-lettering
TRANSCODE_ENABLE_4K=false                  # Allow 2160p rung when source allows it
SPRITE_FRAME_INTERVAL_SECONDS=10          # One scrubbing thumbnail every N seconds
SPRITE_TILE_WIDTH=10                       # Tiles per sprite row
SPRITE_TILE_HEIGHT=10                      # Tile rows per sprite

# --- BullMQ -------------------------------------------------------------------
QUEUE_NAME_TRANSCODE=transcode
QUEUE_NAME_TRANSCODE_DLQ=transcode:dlq
QUEUE_NAME_EMAIL=email
QUEUE_MAX_STALLED_COUNT=2
WORKER_LOCK_DURATION_MS=60000
WORKER_STALLED_INTERVAL_MS=30000

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=900               # Auth + global window
RATE_LIMIT_AUTH_MAX=15                     # Login/register/reset requests per window per IP
RATE_LIMIT_GLOBAL_MAX=300                   # General API requests per window per IP

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StreamEX <no-reply@streamex.dev>"
# When SMTP is not configured, mail is written to stdout (dev fallback).
MAIL_TRANSPORT=console                      # console | smtp

# --- Realtime (Socket.io) -----------------------------------------------------
SOCKET_PATH=/socket.io
REALTIME_EVENT_CHANNEL=events:transcode     # Redis pub/sub channel: worker → api
REALTIME_PROGRESS_CHANNEL=events:progress   # Redis pub/sub channel: api/worker → api

# --- Swagger ------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# --- Nginx (compose only) -----------------------------------------------------
NGINX_HTTP_PORT=8080

# --- Test ---------------------------------------------------------------------
JEST_WORKER_ID=
