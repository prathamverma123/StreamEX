{
  "name": "streamex",
  "version": "1.0.0",
  "private": true,
  "description": "StreamEX — production-grade streaming platform backend, video pipeline and infrastructure",
  "workspaces": [
    "apps/api",
    "apps/worker",
    "packages/storage"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "npm run build --workspace @streamex/storage --if-present",
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "dev": "concurrently --kill-others --names api,worker --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "npm run dev --workspace @streamex/api",
    "dev:worker": "npm run dev --workspace @streamex/worker",
    "build": "npm run build --workspaces --if-present && npm run build:copy-prisma-assets",
    "build:copy-prisma-assets": "node scripts/copy-prisma-assets.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run build --workspace @streamex/storage --if-present && npm test --workspaces --if-present",
    "test:api": "npm test --workspace @streamex/api",
    "test:worker": "npm test --workspace @streamex/worker",
    "test:storage": "npm test --workspace @streamex/storage",
    "test:coverage": "npm run build --workspace @streamex/storage --if-present && npm test --workspaces --if-present -- --coverage",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "npm run db:migrate --workspace @streamex/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @streamex/api",
    "db:enhance": "npm run db:enhance --workspace @streamex/api",
    "db:seed": "npm run db:seed --workspace @streamex/api",
    "db:studio": "npm run db:studio --workspace @streamex/api",
    "start:api": "npm run start --workspace @streamex/api",
    "start:worker": "npm run start --workspace @streamex/worker",
    "package:installer": "npm run package:installer --workspace @streamex/worker"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
