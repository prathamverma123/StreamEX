; ─────────────────────────────────────────────────────────────────────────────
; StreamEX Worker — Inno Setup installer script
;
; Consumes the portable staging dir produced by apps/worker/scripts/package.mjs
; (dist-exe/staging/) and emits a single self-contained setup EXE into
; dist-exe/.
;
; Version is read from scripts/installer/version.iss (generated from
; apps/worker/package.json by the packaging script) so the installer
; version never drifts from the app version.
;
; Build:  ISCC.exe scripts\installer\streamex-worker.iss   (repo root)
; Output: dist-exe\StreamEXWorker-Setup-<version>.exe
; ─────────────────────────────────────────────────────────────────────────────

#define WorkerExeName "streamex-worker.exe"
; Anchor every relative path to THIS script's directory — Inno Setup
; resolves Source/OutputDir paths relative to the .iss, not the caller's cwd.
#define RepoRoot SourcePath + "\..\.."
#define StagingDir RepoRoot + "\dist-exe\staging"

; Version include — generated by the packaging script, never hand-edited.
#include "version.iss"

[Setup]
AppId={{5C9B8CA5-91D7-4F9A-941D-4C46E0E8A1B4}
AppName=StreamEX Worker
AppVersion={#AppVersion}
AppVerName=StreamEX Worker {#AppVersion}
AppPublisher=StreamEX
AppPublisherURL=https://streamex.dev
AppSupportURL=https://streamex.dev/support
AppUpdatesURL=https://streamex.dev/downloads
; Uninstall entry shows the product + version, not the bare exe name.
UninstallDisplayName=StreamEX Worker {#AppVersion}
UninstallDisplayIcon={app}\{#WorkerExeName}
DefaultDirName={autopf}\StreamEX Worker
DefaultGroupName=StreamEX Worker
; Preserve user choices across upgrades.
UsePreviousAppDir=yes
UsePreviousGroup=yes
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
PrivilegesRequired=admin
; A transcode worker is a console service, not a GUI app.
DisableProgramGroupPage=yes
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
OutputDir={#RepoRoot}\dist-exe
OutputBaseFilename=StreamEXWorker-Setup-{#AppVersion}
; The worker is a console process with no open files we must close;
; avoid the "closing applications" restart-manager dialog entirely.
CloseApplications=no
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
SetupAppTitle=StreamEX Worker Setup
SetupWindowTitle=StreamEX Worker Setup

[Tasks]
; Start-menu shortcut is created unconditionally in [Icons]; the desktop
; shortcut stays opt-in.
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional icons:"

[Files]
; The worker binary, the Prisma native engine, docs and the env template —
; everything the portable zip ships, in identical relative positions. The
; engine MUST land beside the exe: exe-main.ts resolves it via
; PRISMA_QUERY_ENGINE_LIBRARY from its own directory first.
Source: "{#StagingDir}\{#WorkerExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#StagingDir}\query_engine-windows.dll.node"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#StagingDir}\README.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#StagingDir}\.env.example"; DestDir: "{app}"; Flags: ignoreversion
; Optional ffmpeg/ffprobe drop-in dir from staging (absent in the default
; build when ffmpeg was not on the packaging machine's PATH).
Source: "{#StagingDir}\bin\*"; DestDir: "{app}\bin"; Flags: ignoreversion skipifsourcedoesntexist recursesubdirs createallsubdirs

[Dirs]
; bin\ exists even when staging had no ffmpeg to bundle, so users can drop
; ffmpeg.exe/ffprobe.exe into it later (exe-main prepends it to PATH).
Name: "{app}\bin"

[Icons]
Name: "{group}\StreamEX Worker"; Filename: "{app}\{#WorkerExeName}"; WorkingDir: "{app}"; Comment: "Start the StreamEX transcode worker"
Name: "{group}\StreamEX Worker Documentation"; Filename: "{app}\README.txt"; WorkingDir: "{app}"; Comment: "Setup and configuration guide"
Name: "{group}\{cm:UninstallProgram,StreamEX Worker}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\StreamEX Worker"; Filename: "{app}\{#WorkerExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
; Post-install checkbox: launch the worker. Skipped automatically in silent
; mode (/SILENT /VERYSILENT), which is exactly what CI and smoke tests want.
Filename: "{app}\{#WorkerExeName}"; Description: "Launch StreamEX Worker"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent
Filename: "{app}\README.txt"; Description: "View the setup guide (README)"; WorkingDir: "{app}"; Flags: postinstall shellexec skipifsilent unchecked

[UninstallDelete]
; Remove runtime artifacts the worker may have created after install
; (transcode scratch output, local storage). .env is left alone — it is
; user data the user authored.
Type: filesandordirs; Name: "{app}\bin"
Type: filesandordirs; Name: "{app}\storage"
Type: filesandordirs; Name: "{app}\work"
Type: filesandordirs; Name: "{app}\logs"

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
var
  VcRedistInstalled: Boolean;
begin
  // The bundled Prisma query engine links against the MSVC runtime.
  // If it is missing, warn once — do not fail the install.
  if CurStep = ssPostInstall then
  begin
    VcRedistInstalled := RegKeyExists(HKEY_LOCAL_MACHINE,
      'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64');
    if not VcRedistInstalled then
      MsgBox(
        'The Prisma query engine bundled with StreamEX Worker requires the ' +
        'Microsoft Visual C++ 2015-2022 Redistributable (x64), which does not ' +
        'appear to be installed.' + #13#10#13#10 +
        'Download it from:' + #13#10 +
        'https://aka.ms/vs/17/release/vc_redist.x64.exe' + #13#10#13#10 +
        'The worker may fail to start without it.',
        mbError, MB_OK);
  end;
end;

procedure CurUninstallStepChanged(CurStep: TUninstallStep);
begin
  // .env and any local storage stay unless the user explicitly opts in.
  if CurStep = usUninstall then
  begin
    if DirExists(ExpandConstant('{app}\storage')) then
      if MsgBox('Also delete saved media files in the installation folder?',
                 mbConfirmation, MB_YESNO) = IDYES then
        DelTree(ExpandConstant('{app}\storage'), True, True, True);
  end;
end;
